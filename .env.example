# Public base URL of the deployment. Used for the gateway's redirect/callback
# URLs and for metadataBase. Falls back to the request origin when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.my

# --- Database ---------------------------------------------------------------
# Postgres connection string. Set this in every deployed environment.
# Supabase: Project settings -> Database -> Connection string -> URI.
# Use the pooled (pgbouncer, port 6543) URI on serverless hosts.
#
# Leave unset locally and the shop runs on PGlite — real Postgres compiled to
# WASM, stored under .data/ — so orders persist across restarts without you
# installing anything. That is development only: a serverless filesystem is
# ephemeral and per-instance, which is exactly what this setting avoids.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Connections per instance. The pg default is 10, which a serverless host
# multiplies by however many instances a traffic spike created — and a Postgres
# server has a fixed budget. Small pools plus a pooled connection string is what
# survives a spike.
DATABASE_POOL_MAX=5

# --- Payment gateway --------------------------------------------------------
# Which provider takes the money: "bayarcash" (default) or "chip". Read by both
# the server and the browser, so the button and the integration cannot disagree.
NEXT_PUBLIC_PAYMENT_GATEWAY=bayarcash

# --- Bayarcash (https://bayarcash.com/) -------------------------------------
# Leave these unset to run the shop in simulation mode: orders are created and
# confirmed without contacting the gateway, which is useful in development but
# must never be used in production.
#
# Console -> Settings -> Personal Access Token, and the portal you collect into.
BAYARCASH_PAT=
BAYARCASH_PORTAL_KEY=

# Signs outgoing payment requests and verifies every callback. Callbacks are
# rejected when this is missing, so payments will never be auto-confirmed
# without it.
BAYARCASH_API_SECRET_KEY=

# Set to 1 to use the sandbox console instead of production.
BAYARCASH_SANDBOX=

# Optional. A channel id (1 = FPX, 5 = DuitNow online banking, 12 = credit
# card, ...) or a comma-separated list. Unset, the payer chooses on Bayarcash's
# own page — see PAYMENT_CHANNELS in src/lib/payments/bayarcash.ts.
BAYARCASH_PAYMENT_CHANNEL=

# Optional base URL override (defaults to https://api.console.bayar.cash/v3)
BAYARCASH_API_URL=

# --- CHIP Collect (https://www.chip-in.asia/) -------------------------------
# The alternative gateway, used only when NEXT_PUBLIC_PAYMENT_GATEWAY=chip.
CHIP_BRAND_ID=
CHIP_SECRET_KEY=

# PEM public key for your CHIP brand, used to verify webhook signatures.
# Webhooks are rejected when this is missing, so payments will never be
# auto-confirmed without it.
CHIP_PUBLIC_KEY=

# Optional gateway override (defaults to https://gate.chip-in.asia/api/v1)
CHIP_API_URL=

# --- Admin ------------------------------------------------------------------
# The admin area at /admin lists customers' names, phone numbers and addresses.
# It is DISABLED unless both of these are set — a missing password never means
# "no password required".
ADMIN_PASSWORD=            # at least 12 characters
ADMIN_SESSION_SECRET=      # random string, e.g. `openssl rand -base64 32`

# --- Agent (KretivWork) -----------------------------------------------------
# The sole agent earns a flat fee on EVERY sale, separately from any affiliate
# commission. Both can apply to the same order.
AGENT_NAME=KretivWork
AGENT_FEE_PER_SALE=2          # ringgit; 0 disables the arrangement
# "order" = one fee per order (default). "unit" = one fee per jar.
# A four-jar order pays RM 2.00 on "order" and RM 8.00 on "unit" — confirm
# which the agreement means before going live.
AGENT_FEE_BASIS=order

# --- Partner API ------------------------------------------------------------
# Bearer key for the central dashboard's read-only sales feed. Minimum 24
# characters. Unset disables the endpoints rather than leaving them open.
# Generate with: openssl rand -base64 32
PARTNER_API_KEY=
